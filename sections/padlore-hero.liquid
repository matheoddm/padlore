{% comment %}
  PADLORE — Hero
  - Main H1 of the homepage.
  - Desktop layout "split": text on the left, product image on the right
    (blends into the dark background). Layout "background": image behind the text.
  - Mobile: dedicated portrait image (falls back to the desktop image) behind the text.
  - Without any image: text only on the dark background (no stand-in product visuals).
    In the theme editor only, an empty frame shows where the image will go.
  - The hero image is loaded with high priority (above the fold, never lazy).
{% endcomment %}

{{ 'section-padlore-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile
  assign main_image = desktop_image | default: mobile_image
  assign has_image = false
  if main_image != blank
    assign has_image = true
  endif
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0

  if section.settings.layout_desktop == 'split'
    assign image_sizes = '(min-width: 990px) 60vw, 100vw'
  else
    assign image_sizes = '100vw'
  endif

  assign show_button_1 = false
  if section.settings.button_label_1 != blank and section.settings.button_link_1 != blank
    assign show_button_1 = true
  endif
  assign show_button_2 = false
  if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank
    assign show_button_2 = true
  endif
-%}

<section
  id="PadloreHero-{{ section.id }}"
  class="padlore-hero padlore-hero--{{ section.settings.height }} padlore-hero--layout-{{ section.settings.layout_desktop }} padlore-hero--align-{{ section.settings.text_alignment }} color-{{ section.settings.color_scheme }} gradient{% if has_image %} padlore-hero--has-image{% else %} padlore-hero--no-image{% endif %}"
  style="--padlore-hero-overlay: {{ overlay }};"
>
  {%- if has_image -%}
    <div class="padlore-hero__media">
      <picture>
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1100 }} 1100w,
              {{ mobile_image | image_url: width: 1500 }} 1500w
            "
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {%- endif -%}
        {%- liquid
          assign focal_style = 'object-position: ' | append: main_image.presentation.focal_point | append: ';'
        -%}
        {{
          main_image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 1920, 2400, 3000',
            sizes: image_sizes,
            loading: 'eager',
            fetchpriority: 'high',
            class: 'padlore-hero__image',
            style: focal_style,
            alt: main_image.alt
        }}
      </picture>
    </div>
  {%- elsif request.design_mode -%}
    <div class="padlore-hero__placeholder" aria-hidden="true">
      <span>Hero image — add it in the section settings</span>
    </div>
  {%- endif -%}

  <div class="padlore-hero__content page-width">
    <div class="padlore-hero__inner">
      {%- if section.settings.heading != blank -%}
        {%- comment -%}Each sentence stays together on its own line ("Your Pad." / "Your Story."){%- endcomment -%}
        {%- assign heading_parts = section.settings.heading | split: '. ' -%}
        <h1 class="padlore-hero__heading hxl">
          {%- for part in heading_parts -%}
            <span class="padlore-hero__heading-line">{{ part | escape }}{% unless forloop.last %}.{% endunless %}</span>
            {%- unless forloop.last %} {% endunless -%}
          {%- endfor -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="padlore-hero__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if show_button_1 or show_button_2 -%}
        <div class="padlore-hero__buttons">
          {%- if show_button_1 -%}
            <a href="{{ section.settings.button_link_1 }}" class="button button--primary padlore-hero__button--primary">
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if show_button_2 -%}
            <a href="{{ section.settings.button_link_2 }}" class="button button--secondary padlore-hero__button--secondary">
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PADLORE Hero",
  "tag": "div",
  "class": "section section-padlore-hero",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Split layout: the mat should sit in the right half of the photo. At least 2400 px wide. Set the focal point on the mat."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Portrait photo (about 4:5 or 9:16), at least 1100 px wide. The text sits over it. If empty, the desktop image is used."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image darkening",
      "info": "Darkens the image so the text stays readable.",
      "default": 35
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (main page title)",
      "default": "Your Pad. Your Story."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Turn your workspace into something personal. Explore artistic desk mats designed to complement your setup."
    },
    {
      "type": "header",
      "content": "Buttons",
      "info": "A button is shown only when it has both a label and a link."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Main button label (violet)",
      "default": "Shop Collections"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Main button link",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label (outline)",
      "default": "Customize Your Mat"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Desktop layout",
      "options": [
        { "value": "split", "label": "Text left, image right" },
        { "value": "background", "label": "Image behind the text" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment (image behind the text, or no image)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "PADLORE Hero"
    }
  ]
}
{% endschema %}
