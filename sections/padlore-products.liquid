{% comment %}
  PADLORE — Featured products ("Featured designs.")
  - Up to 4 products chosen in the theme editor, equal square cards.
  - Name + real Shopify price ("From" when sizes have different prices).
    Prices are never typed in the code.
  - Hover (computers): slow zoom, and the product's second image if it has one.
  - Empty product slots are only shown in the theme editor; on the live store
    they are skipped, and the section hides itself when no product is chosen.
  - "Sheet" layout: off-white sheet resting on the dark background (same
    principle as the editorial index).
{% endcomment %}

{%- liquid
  assign chosen = 0
  for block in section.blocks
    if block.settings.product != blank
      assign chosen = chosen | plus: 1
    endif
  endfor
-%}

{%- if chosen > 0 or request.design_mode -%}
  {{ 'section-padlore-products.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'padlore-reveal.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'padlore-products.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    #PadloreProducts-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      #PadloreProducts-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="padlore-products-frame padlore-products-frame--{{ section.settings.layout }} color-{{ section.settings.surround_scheme }} gradient">
    <div
      id="PadloreProducts-{{ section.id }}"
      class="padlore-products color-{{ section.settings.color_scheme }} gradient"
      data-padlore-reveal
    >
      <div class="page-width">
        <div class="padlore-products__header padlore-products__header--{{ section.settings.header_style }}">
          <div>
            {%- if section.settings.heading != blank -%}
              <h2 class="padlore-products__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="padlore-products__subheading">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="padlore-products__all{% if section.settings.header_style == 'centered' %} button button--primary padlore-products__button{% endif %}">
              {{- section.settings.link_label | escape -}}
              <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 20 20" fill="none">
                <path d="M4 10h11.5M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>

        <ul class="padlore-products__grid list-unstyled" role="list" data-padlore-rail>
          {%- assign shown = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              {%- liquid
                assign shown = shown | plus: 1
                assign first_image = product.featured_media.preview_image
                assign first_alt = first_image.alt | default: product.title
                assign second_image = nil
                if section.settings.show_second_image and product.media.size > 1
                  assign second_image = product.media[1].preview_image
                endif
              -%}
              <li class="padlore-products__item" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
                <a href="{{ product.url }}" class="padlore-products__card{% if second_image %} padlore-products__card--swap{% endif %}">
                  <div class="padlore-products__media">
                    {%- if first_image -%}
                      {{
                        first_image
                        | image_url: width: 1000
                        | image_tag:
                          widths: '300, 450, 600, 800, 1000',
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw',
                          loading: 'lazy',
                          class: 'padlore-products__image',
                          alt: first_alt
                      }}
                    {%- endif -%}
                    {%- if second_image -%}
                      {{
                        second_image
                        | image_url: width: 1000
                        | image_tag:
                          widths: '300, 450, 600, 800, 1000',
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw',
                          loading: 'lazy',
                          class: 'padlore-products__image padlore-products__image--second',
                          alt: ''
                      }}
                    {%- endif -%}
                    <span class="padlore-products__go" aria-hidden="true">
                      <svg focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none">
                        <path d="M4 10h11.5M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                  <div class="padlore-products__meta">
                    {%- if section.settings.show_index -%}
                      <span class="padlore-products__index" aria-hidden="true">{% if shown < 10 %}0{% endif %}{{ shown }}</span>
                    {%- endif -%}
                    <h3 class="padlore-products__name">{{ product.title | escape }}</h3>
                    <p class="padlore-products__price">
                      {%- if product.price_varies -%}
                        {{ section.settings.price_prefix | escape }}
                        {{ product.price_min | money }}
                      {%- else -%}
                        {{ product.price | money }}
                      {%- endif -%}
                    </p>
                  </div>
                </a>
              </li>
            {%- elsif request.design_mode -%}
              <li class="padlore-products__item" {{ block.shopify_attributes }}>
                <div class="padlore-products__card padlore-products__card--empty">
                  <div class="padlore-products__media"></div>
                  <div class="padlore-products__meta">
                    <p class="padlore-products__name">Choose a product</p>
                    <p class="padlore-products__price">Price from Shopify</p>
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if chosen > 1 -%}
          <div class="padlore-products__counter" aria-hidden="true">
            <span class="padlore-products__counter-now" data-padlore-rail-now>01</span>
            <span class="padlore-products__counter-track"><span class="padlore-products__counter-bar"></span></span>
            <span>{% if chosen < 10 %}0{% endif %}{{ chosen }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PADLORE Products",
  "tag": "section",
  "class": "section section-padlore-products",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured designs."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover artistic desk mats made to match your style."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop All Mats"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "info": "Shown before the lowest price when sizes have different prices.",
      "default": "From"
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "Show product numbers (01, 02…)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show the second product image on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_style",
      "label": "Header style",
      "options": [
        { "value": "centered", "label": "Centered, with a violet button" },
        { "value": "split", "label": "Title left, underlined link right" }
      ],
      "default": "centered"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "sheet", "label": "Sheet resting on the dark background" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "sheet"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "surround_scheme",
      "label": "Background around the sheet",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PADLORE Products",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
