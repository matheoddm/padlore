{% comment %}
  (sync 25/11/2026)
  PADLORE — Editorial Index (reassurance, right under the hero)
  - Three compact lines: title (Syne, sentence case), short line, optional link.
  - Calm by design: soft fade-in once on scroll (assets/padlore-kinetic-index.js),
    subtle hover on computers (line slides, violet dash grows, arrow moves).
  - Reduced motion / no JavaScript / theme editor: static.
{% endcomment %}

{{ 'section-padlore-reassurance.css' | asset_url | stylesheet_tag }}
<script src="{{ 'padlore-kinetic-index.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #PadloreIndex-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PadloreIndex-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="padlore-index-frame padlore-index-frame--{{ section.settings.layout }} color-{{ section.settings.surround_scheme }} gradient">
<div
  id="PadloreIndex-{{ section.id }}"
  class="padlore-index color-{{ section.settings.color_scheme }} gradient"
  data-padlore-index
>
  {%- if section.blocks.size > 0 -%}
    <ul class="padlore-index__list page-width list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="padlore-index__item" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="padlore-index__row padlore-index__row--link">
          {%- else -%}
            <div class="padlore-index__row">
          {%- endif -%}
              <span class="padlore-index__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}
                <span class="padlore-index__text">
                  <span class="padlore-index__dash" aria-hidden="true"></span>
                  {{- block.settings.text | escape -}}
                </span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <svg class="padlore-index__arrow" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none">
                  <path d="M4 10h11.5M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
</div>

{% schema %}
{
  "name": "PADLORE Editorial Index",
  "tag": "section",
  "class": "section section-padlore-index",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "sheet", "label": "Sheet resting on the dark background" },
        { "value": "full", "label": "Full width band" }
      ],
      "default": "sheet",
      "info": "Sheet: the band sits like a mat on a desk, slightly over the bottom of the section above."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Band color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "surround_scheme",
      "label": "Background around the sheet",
      "info": "Use the same dark scheme as the hero and the collections for one continuous surface.",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Line",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30 Sizes"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short line",
          "default": "Find your fit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Makes the whole line clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PADLORE Editorial Index",
      "blocks": [
        {
          "type": "line",
          "settings": { "title": "30 Sizes", "text": "Find your fit" }
        },
        {
          "type": "line",
          "settings": { "title": "6 Collections", "text": "Explore your style", "link": "/collections" }
        },
        {
          "type": "line",
          "settings": { "title": "Your Style", "text": "Make it personal" }
        }
      ]
    }
  ]
}
{% endschema %}
