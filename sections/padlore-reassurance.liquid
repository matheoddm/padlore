{% comment %}
  PADLORE — Kinetic Index (reassurance, right under the hero)
  - Each block is one line: an oversized Syne title (outline until active),
    an optional accent word in violet, a short line and an optional link.
  - Motion (assets/padlore-kinetic-index.js, no library):
      · lines rise in once, one after the other, when the section enters the screen;
      · the line crossing the middle of the screen fills in (outline → solid);
      · on computers, hovering a line fills it.
  - Without JavaScript, with reduced motion or in the theme editor: every title
    is shown filled, with no movement.
{% endcomment %}

{{ 'section-padlore-reassurance.css' | asset_url | stylesheet_tag }}
<script src="{{ 'padlore-kinetic-index.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #PadloreIndex-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PadloreIndex-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="PadloreIndex-{{ section.id }}"
  class="padlore-index color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_glow %} padlore-index--glow{% endif %}"
  data-padlore-index
>
  {%- if section.blocks.size > 0 -%}
    <ul class="padlore-index__list page-width list-unstyled" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = block.settings.title | escape
          assign accent = block.settings.accent | strip | escape
          if accent != blank and title contains accent
            assign accent_html = '<span class="padlore-index__accent">' | append: accent | append: '</span>'
            assign title = title | replace_first: accent, accent_html
          endif
        -%}
        <li class="padlore-index__item" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="padlore-index__row padlore-index__row--link">
          {%- else -%}
            <div class="padlore-index__row">
          {%- endif -%}
              <span class="padlore-index__title">{{ title }}</span>
              {%- if block.settings.text != blank -%}
                <span class="padlore-index__text">
                  <span class="padlore-index__dash" aria-hidden="true"></span>
                  {{- block.settings.text | escape -}}
                  {%- if block.settings.link != blank -%}
                    <svg class="padlore-index__arrow" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 20 20" fill="none">
                      <path d="M4 10h11.5M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </span>
              {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "PADLORE Kinetic Index",
  "tag": "section",
  "class": "section section-padlore-index",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Soft violet glow",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Line",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Keep it short (about 13 characters max) so it fits on one line.",
          "default": "30 Sizes"
        },
        {
          "type": "text",
          "id": "accent",
          "label": "Word in violet",
          "info": "Must appear in the title, e.g. \"30\". Leave empty for none.",
          "default": "30"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short line",
          "default": "Find your fit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Makes the whole line clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PADLORE Kinetic Index",
      "blocks": [
        {
          "type": "line",
          "settings": { "title": "30 Sizes", "accent": "30", "text": "Find your fit" }
        },
        {
          "type": "line",
          "settings": { "title": "6 Collections", "accent": "6", "text": "Explore your style", "link": "/collections" }
        },
        {
          "type": "line",
          "settings": { "title": "Your Style", "accent": "Your", "text": "Make it personal" }
        }
      ]
    }
  ]
}
{% endschema %}
