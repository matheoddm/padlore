{% comment %}
  PADLORE — Customization teaser ("Make it yours.")
  - Presents the service only: the real configurator is a separate project.
  - Image left, text right (computers); image on top (phones).
    Without an image: text only, centred (an empty frame is shown in the
    theme editor only — no stand-in visual on the live store).
  - Steps are blocks (icon, title, one line). Soft reveal once on scroll.
{% endcomment %}

{{ 'section-padlore-customize.css' | asset_url | stylesheet_tag }}
<script src="{{ 'padlore-reveal.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #PadloreCustomize-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.65 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PadloreCustomize-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign image = section.settings.image
  assign has_media = false
  if image != blank or request.design_mode
    assign has_media = true
  endif

  assign heading = section.settings.heading | escape
  assign accent = section.settings.heading_accent | strip | escape
  if accent != blank and heading contains accent
    assign accent_html = '<span class="padlore-customize__accent">' | append: accent | append: '</span>'
    assign heading = heading | replace_first: accent, accent_html
  endif
-%}

<div
  id="PadloreCustomize-{{ section.id }}"
  class="padlore-customize color-{{ section.settings.color_scheme }} gradient{% unless has_media %} padlore-customize--text-only{% endunless %}"
  data-padlore-reveal
>
  <div class="padlore-customize__inner page-width">
    {%- if has_media -%}
      <div class="padlore-customize__media{% if image == blank %} padlore-customize__media--empty{% endif %}">
        {%- if image != blank -%}
          {%- assign focal_style = 'object-position: ' | append: image.presentation.focal_point | append: ';' -%}
          {{
            image
            | image_url: width: 1600
            | image_tag:
              widths: '600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'lazy',
              class: 'padlore-customize__image',
              style: focal_style
          }}
        {%- else -%}
          <span class="padlore-customize__placeholder">Image — add it in the section settings</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="padlore-customize__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="padlore-customize__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="padlore-customize__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="padlore-customize__steps list-unstyled" role="list">
          {%- for block in section.blocks -%}
            <li class="padlore-customize__step" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              <span class="padlore-customize__icon" aria-hidden="true">
                <svg focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {%- case block.settings.icon -%}
                    {%- when 'upload' -%}
                      <path d="M12 16V5M7 10l5-5 5 5"/>
                      <path d="M5 19h14"/>
                    {%- when 'preview' -%}
                      <rect x="3.5" y="6.5" width="17" height="11" rx="2"/>
                      <path d="M7.5 14.5l3-3 2.5 2.5 2-2 1.5 1.5"/>
                    {%- else -%}
                      <path d="M5 12.5l4.5 4.5L19 7.5"/>
                  {%- endcase -%}
                </svg>
              </span>
              <div>
                {%- if block.settings.title != blank -%}
                  <p class="padlore-customize__step-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="padlore-customize__step-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary padlore-customize__button">
          {{- section.settings.button_label | escape -}}
          <svg class="padlore-customize__arrow" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h11.5M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PADLORE Customize",
  "tag": "section",
  "class": "section section-padlore-customize",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A custom desk mat on a desk. Landscape (4:3), at least 1600 px wide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make it yours."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Word in violet",
      "info": "Must appear in the heading. Leave empty for none.",
      "default": "yours."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your image. Your dimensions. Your desk mat."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Customize Your Mat"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "upload", "label": "Upload" },
            { "value": "preview", "label": "Preview" },
            { "value": "create", "label": "Check" }
          ],
          "default": "upload"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Upload"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short line",
          "default": "Add your JPG or PNG."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PADLORE Customize",
      "blocks": [
        { "type": "step", "settings": { "icon": "upload", "title": "Upload", "text": "Add your JPG or PNG." } },
        { "type": "step", "settings": { "icon": "preview", "title": "Preview", "text": "See it on your chosen size." } },
        { "type": "step", "settings": { "icon": "create", "title": "Create", "text": "Add it to your cart." } }
      ]
    }
  ]
}
{% endschema %}
