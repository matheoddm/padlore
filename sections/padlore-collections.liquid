{% comment %}
  (sync 25/11/2026)
  PADLORE — Collections ("Find your aesthetic.")
  - Up to 4 collection cards of equal size, chosen in the theme editor.
  - Card image: the block's own image, else the collection image.
    Without any image: a plain dark card with the name (no stand-in visuals).
  - Computers: 4 columns. Tablets: 2 × 2. Phones: a row you swipe, with a
    thin violet progress line (assets/padlore-collections.js).
  - Cards rise in once on scroll; hover zooms the image slowly.
    Reduced motion / no JavaScript / theme editor: no movement.
{% endcomment %}

{{ 'section-padlore-collections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'padlore-collections.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #PadloreCollections-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PadloreCollections-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading | escape
  assign accent = section.settings.heading_accent | strip | escape
  if accent != blank and heading contains accent
    assign accent_html = '<span class="padlore-collections__accent">' | append: accent | append: '</span>'
    assign heading = heading | replace_first: accent, accent_html
  endif
-%}

<div
  id="PadloreCollections-{{ section.id }}"
  class="padlore-collections color-{{ section.settings.color_scheme }} gradient padlore-collections--{{ section.settings.card_ratio }}"
  data-padlore-collections
>
  <div class="page-width">
    <div class="padlore-collections__header">
      <div class="padlore-collections__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="padlore-collections__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="padlore-collections__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="padlore-collections__all">
          {{- section.settings.link_label | escape -}}
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h11.5M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="padlore-collections__rail-wrap page-width">
      <ul class="padlore-collections__grid list-unstyled" role="list" data-padlore-rail>
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign card_title = block.settings.title | default: collection.title
            assign card_image = block.settings.image | default: collection.featured_image
            assign card_url = nil
            if collection != blank
              assign card_url = collection.url
            endif
          -%}
          <li class="padlore-collections__item" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            {%- if card_url -%}
              <a href="{{ card_url }}" class="padlore-collections__card{% if card_image == blank %} padlore-collections__card--empty{% endif %}">
            {%- else -%}
              <div class="padlore-collections__card padlore-collections__card--static{% if card_image == blank %} padlore-collections__card--empty{% endif %}">
            {%- endif -%}
                <div class="padlore-collections__media{% if card_image == blank %} padlore-collections__media--empty{% endif %}">
                  {%- if card_image != blank -%}
                    {%- liquid
                      assign focal_style = 'object-position: ' | append: card_image.presentation.focal_point | append: ';'
                      assign card_alt = card_image.alt | default: card_title
                    -%}
                    {{
                      card_image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '400, 600, 800, 1000, 1200, 1400',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 78vw',
                        loading: 'lazy',
                        class: 'padlore-collections__image',
                        style: focal_style,
                        alt: card_alt
                    }}
                  {%- endif -%}
                </div>
                <div class="padlore-collections__caption">
                  <div>
                    {%- if card_title != blank -%}
                      <h3 class="padlore-collections__name">{{ card_title | escape }}</h3>
                    {%- endif -%}
                    {%- if card_url and section.settings.explore_label != blank -%}
                      <span class="padlore-collections__explore">
                        <span class="padlore-collections__dash" aria-hidden="true"></span>
                        {{- section.settings.explore_label | escape -}}
                      </span>
                    {%- endif -%}
                  </div>
                </div>
                {%- if card_url -%}
                  <span class="padlore-collections__arrow" aria-hidden="true">
                    <svg focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none">
                      <path d="M4 10h11.5M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {%- endif -%}
            {%- if card_url -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="padlore-collections__progress" aria-hidden="true">
        <span class="padlore-collections__progress-bar"></span>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "PADLORE Collections",
  "tag": "section",
  "class": "section section-padlore-collections",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your aesthetic."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Word in violet",
      "info": "Must appear in the heading. Leave empty for none."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Different moods. One space that's yours."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View All Collections"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "explore_label",
      "label": "Card label",
      "default": "Explore"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Card shape",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "tall", "label": "Tall (3:4)" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name on the card",
          "info": "Leave empty to use the collection's name."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Optional. Replaces the collection image. Portrait photo, at least 1200 px wide. Set the focal point on the mat."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PADLORE Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
