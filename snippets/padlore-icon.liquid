{% comment %}
  PADLORE — line icons (24 × 24, 1.5 px stroke, current text color).
  Decorative: always hidden from screen readers.

  Usage: {% render 'padlore-icon', icon: 'ruler', size: 28 %}
  Icons: ruler, palette, desk, resize, layers, brush, sparkle, lock, truck, globe
{% endcomment %}

{%- assign icon_size = size | default: 24 -%}
<svg
  class="padlore-icon padlore-icon--{{ icon }}"
  aria-hidden="true"
  focusable="false"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {%- case icon -%}
    {%- when 'ruler' -%}
      <rect x="2.5" y="7.5" width="19" height="9" rx="1.5"/>
      <path d="M6.5 7.5v3M10 7.5v4.5M13.5 7.5v3M17 7.5v4.5"/>
    {%- when 'palette' -%}
      <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.8-1.7h2.1A4.3 4.3 0 0 0 21 11c0-4.4-4-8-9-8z"/>
      <circle cx="7.5" cy="11" r="1"/>
      <circle cx="10.5" cy="7.5" r="1"/>
      <circle cx="15" cy="7.8" r="1"/>
    {%- when 'desk' -%}
      <rect x="5" y="3.5" width="14" height="9" rx="1.2"/>
      <path d="M12 12.5v3M9 15.5h6"/>
      <rect x="2.5" y="17.5" width="19" height="3" rx="1"/>
    {%- when 'resize' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="2"/>
      <path d="M8 16l8-8M11.5 8H16v4.5M12.5 16H8v-4.5"/>
    {%- when 'layers' -%}
      <path d="M12 3.5l8.5 4.5-8.5 4.5L3.5 8z"/>
      <path d="M3.5 12l8.5 4.5 8.5-4.5"/>
      <path d="M3.5 16l8.5 4.5 8.5-4.5"/>
    {%- when 'brush' -%}
      <path d="M14.5 4.5l5 5-7.5 7.5-5-5z"/>
      <path d="M7 12l-1.8 1.8a2.5 2.5 0 0 0 0 3.5l-.7 3.2 3.2-.7a2.5 2.5 0 0 0 3.5 0L13 18"/>
    {%- when 'sparkle' -%}
      <path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9-1.9 5.1-1.9-5.1-5.1-1.9 5.1-1.9z"/>
      <path d="M18.5 16v4M16.5 18h4"/>
    {%- when 'lock' -%}
      <rect x="4.5" y="10.5" width="15" height="10" rx="2"/>
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
      <path d="M12 14.5v2"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11z"/>
      <path d="M13.5 9.5h4l3 3v3h-7"/>
      <circle cx="7" cy="17.5" r="1.8"/>
      <circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M3.5 12h17M12 3.5c2.3 2.4 3.5 5.2 3.5 8.5s-1.2 6.1-3.5 8.5c-2.3-2.4-3.5-5.2-3.5-8.5s1.2-6.1 3.5-8.5z"/>
  {%- endcase -%}
</svg>
